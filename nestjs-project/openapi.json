            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get video thumbnail via 302 Found redirect",
        "tags": [
          "videos"
        ]
      }
    },
